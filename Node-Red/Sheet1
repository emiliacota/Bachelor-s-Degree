        "height": 5,
        "format": "<div style=\"\n  width: 100%; \n  height: 100%; \n  padding: 12px; \n  box-sizing: border-box; \n  background: #222222; \n  border: 1px solid #2D4A2D; \n  border-radius: 12px; \n  box-shadow: 0 4px 6px rgba(0,0,0,0.3);\n  display: flex; \n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\">\n\n    <div style=\"font-size:18px; color:white; font-weight:500; margin-bottom:4px; text-align:center; width:100%;\">\n        Air Humidity\n    </div>\n\n    <div\n        style=\"position:relative; width:100%; flex:1; display:flex; flex-direction:column; align-items:center; min-height:0;\">\n        <canvas id=\"humidity-canvas\" style=\"width:100%; max-width:220px; height:110px;\"></canvas>\n\n        <div style=\"position:absolute; bottom:10px; text-align:center;\">\n            <span id=\"humidity-val\" style=\"font-size:24px; color:white; font-weight:bold;\">0.0%</span>\n            <div style=\"font-size:11px; color:#888; margin-top:-2px;\">rH</div>\n        </div>\n    </div>\n\n    <div\n        style=\"width:100%; max-width:200px; display:flex; justify-content:space-between; font-size:10px; color:#666; margin-top:-5px; padding:0 10px;\">\n        <span>0</span>\n        <span>100</span>\n    </div>\n</div>\n\n<script>\n    (function($scope) {\n  var canvas, ctx;\n  var currentVal = 0;\n\n  function init() {\n    canvas = document.getElementById('humidity-canvas');\n    if (!canvas) return false;\n    ctx = canvas.getContext('2d');\n    return true;\n  }\n\n  function draw(val) {\n    if (!ctx) return;\n    \n    // Sincronizare dimensiuni canvas\n    var W = canvas.offsetWidth;\n    var H = canvas.offsetHeight;\n    canvas.width = W;\n    canvas.height = H;\n\n    ctx.clearRect(0, 0, W, H);\n\n    var cx = W / 2;\n    var cy = H - 5;\n    var radius = Math.min(cx, cy) - 15;\n\n    // 1. Arcul de fundal (Gri închis)\n    ctx.beginPath();\n    ctx.arc(cx, cy, radius, Math.PI, 0, false);\n    ctx.lineWidth = 14;\n    ctx.strokeStyle = '#333333';\n    ctx.lineCap = 'round';\n    ctx.stroke();\n\n    // 2. Arcul activ de umiditate (Albastru aprins ca cel vechi)\n    if (val > 0) {\n      var angle = Math.PI + (Math.min(val, 100) / 100) * Math.PI;\n      ctx.beginPath();\n      ctx.arc(cx, cy, radius, Math.PI, angle, false);\n      ctx.lineWidth = 14;\n      ctx.strokeStyle = '#0096FF'; // Culoarea albastră\n      ctx.lineCap = 'round';\n      ctx.stroke();\n    }\n  }\n\n  $scope.$watch('msg', function(msg) {\n    if (!msg || msg.payload === undefined) return;\n    var val = parseFloat(msg.payload);\n    if (isNaN(val)) return;\n\n    currentVal = val;\n    \n    // Actualizăm textul rapid\n    var txt = document.getElementById('humidity-val');\n    if (txt) txt.textContent = val.toFixed(1) + '%';\n\n    if (!ctx && !init()) return;\n    draw(currentVal);\n  });\n\n  // Re-desenare în caz de resize pagină\n  window.addEventListener('resize', function() {\n    if (ctx) draw(currentVal);\n  });\n})(scope);\n</script>",
