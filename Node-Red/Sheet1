        "format": "<div style=\"\n  width: 100%; \n  height: 100%; \n  padding: 12px; \n  box-sizing: border-box; \n  background: #222222; \n  border: 1px solid #2D4A2D; \n  border-radius: 12px; \n  box-shadow: 0 4px 6px rgba(0,0,0,0.3);\n  display: flex; \n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\">\n\n  <div style=\"font-size:18px; color:white; font-weight:500; margin-bottom:12px; text-align:center;\">Temperature</div>\n\n  <svg viewBox=\"0 0 60 160\" width=\"70\" height=\"160\">\n\n    <rect x=\"22\" y=\"10\" width=\"16\" height=\"105\" rx=\"8\" fill=\"#2a2a3e\" stroke=\"#555\" stroke-width=\"1.5\" />\n\n    <rect id=\"tf\" x=\"24\" y=\"80\" width=\"12\" height=\"35\" rx=\"4\" fill=\"#2ecc71\" />\n\n    <circle id=\"tb\" cx=\"30\" cy=\"118\" r=\"14\" fill=\"#2ecc71\" stroke=\"#555\" stroke-width=\"1.5\" />\n\n    <line x1=\"38\" y1=\"20\" x2=\"44\" y2=\"20\" stroke=\"#888\" stroke-width=\"1\" />\n    <line x1=\"38\" y1=\"35\" x2=\"44\" y2=\"35\" stroke=\"#888\" stroke-width=\"1\" />\n    <line x1=\"38\" y1=\"50\" x2=\"44\" y2=\"50\" stroke=\"#888\" stroke-width=\"1\" />\n    <line x1=\"38\" y1=\"65\" x2=\"44\" y2=\"65\" stroke=\"#888\" stroke-width=\"1\" />\n    <line x1=\"38\" y1=\"80\" x2=\"44\" y2=\"80\" stroke=\"#888\" stroke-width=\"1\" />\n    <line x1=\"38\" y1=\"95\" x2=\"44\" y2=\"95\" stroke=\"#888\" stroke-width=\"1\" />\n    <line x1=\"38\" y1=\"110\" x2=\"44\" y2=\"110\" stroke=\"#888\" stroke-width=\"1\" />\n\n    <text x=\"46\" y=\"23\" font-size=\"8\" fill=\"#aaa\">50°</text>\n    <text x=\"46\" y=\"53\" font-size=\"8\" fill=\"#aaa\">30°</text>\n    <text x=\"46\" y=\"83\" font-size=\"8\" fill=\"#aaa\">15°</text>\n    <text x=\"46\" y=\"113\" font-size=\"8\" fill=\"#aaa\">0°</text>\n\n    <text id=\"tv\" x=\"30\" y=\"122\" text-anchor=\"middle\" font-size=\"7\" font-weight=\"bold\" fill=\"white\">\n      --°\n    </text>\n\n  </svg>\n\n</div>\n\n<script>\n  (function($scope) {\n    $scope.$watch('msg', function(msg) {\n        if (!msg || msg.payload === undefined) return;\n        \n        var val = parseFloat(msg.payload);\n        if (isNaN(val)) return;\n        \n        document.getElementById('tv').textContent = val.toFixed(1) + '°';\n        \n        var fillH = Math.min(Math.max((val / 50) * 105, 4), 105);\n        var fillY = 115 - fillH;\n        document.getElementById('tf').setAttribute('y', fillY);\n        document.getElementById('tf').setAttribute('height', fillH);\n        \n        var color;\n        if (val < 15)       color = '#3498db';\n        else if (val < 28)  color = '#2ecc71';\n        else if (val < 35)  color = '#f39c12';\n        else                color = '#e74c3c';\n        \n        document.getElementById('tf').style.fill = color;\n        document.getElementById('tb').style.fill = color;\n    });\n})(scope);\n</script>",
